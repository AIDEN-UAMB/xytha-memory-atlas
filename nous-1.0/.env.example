# Optional: omit these to run deterministic chart answers without a model.
# Copy this file to .env. Supply YOUR account's model ID and API key.
NOUS_API_KEY=
NOUS_BASE_URL=https://api.deepseek.com
NOUS_PROTOCOL=openai-chat
NOUS_PROVIDER=deepseek
NOUS_MODEL=
NOUS_JSON_MODE=true
NOUS_THINKING=auto
PORT=4174
# Original v1 defaults for this local distribution. No Nous 2.0 features enabled.
XYTHA_FRAMEWORK_V1=true
XYTHA_ADAPTIVE_CONTEXT=true
XYTHA_RESUMABLE_CHAT=true
XYTHA_DIRECT_OUTPUT=false
XYTHA_CHAT_HOURLY_LIMIT=30
